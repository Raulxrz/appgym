# Copia este archivo como .env.local y rellénalo. Los pasos están en el README.
APP_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Genera uno con: openssl rand -base64 48
SESSION_SECRET=
# Para el selector de archivos de Drive (Google Picker). Son públicos: restringe la clave por dominio.
NEXT_PUBLIC_GOOGLE_API_KEY=
NEXT_PUBLIC_GOOGLE_PROJECT_NUMBER=
# Código de verificación de Google Search Console (solo el valor de content="...").
GOOGLE_SITE_VERIFICATION=
